	(text "J1 = XDRIVE header [GND MOSI MISO SCK GPIO_6 3.3V].\nMOSI unused. GPIO_6 = LATCH: ffbeast pulses it to load\nthe 165s (SH/~LD). Check bit order on the bench:\nU1.Q7 = input H = button 7 shifts out first."
		(exclude_from_sim no)
		(at 345.44 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "68ac8f26-0ee6-531a-b1aa-bdd67a4078cb")
	)
	(text "Shift order: U2.Q7 -> U1.DS (CHAIN), U1.Q7 -> MISO.\nU2 inputs C..H and U2.DS tied to +3V3 = 'released'.\n74HC165 at 3.3 V is fine to ~15 MHz SCK; SN74LV165A is a pin-compatible\nfaster alternative."
		(exclude_from_sim no)
		(at 317.5 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b4d5d1d-f5a3-566a-aaae-1685caade6ba")
	)
