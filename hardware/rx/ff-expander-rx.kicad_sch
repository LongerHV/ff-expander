	(uuid "5ee28406-605c-5eeb-9f42-fb28d461b2cf")
	(paper "A3")
	(title_block
		(title "ff-expander RX (base)")
		(date "2026-11-23")
		(rev "A")
		(company "ff-expander")
		(comment 4 "Failsafe: pull-ups hold every 165 input 'released' (high) unless the ESP drives it.")
		(comment 3 "165s + pull-ups run from the XDRIVE 3.3 V, so a dead XIAO reads as 'all released'.")
		(comment 2 "XIAO runs from the XDRIVE 5 V via D1. 1k series resistors limit back-powering.")
		(comment 1 "D6 (GPIO16, UART0 TX, toggled by boot ROM) is NOT used; button 6 is on D10.")
	)
