	(title_block
		(title "ff-expander TX (wheel): XIAO ESP32-C6 + LiPo + 10 buttons")
		(date "2026-11-23")
		(rev "A")
		(company "ff-expander")
		(comment 1 "Buttons switch to GND. External 10k pull-ups + 10 nF filter against motor noise and")
		(comment 2 "eager-debounce false triggers; 1k series for ESD and to protect D6 (UART0 TX at boot).")
		(comment 3 "D1/D2 are the deep-sleep wake buttons (LP GPIOs).")
		(comment 4 "Battery sense divider (R21/R22/C11) is for future firmware: DNP for now.")
	)
